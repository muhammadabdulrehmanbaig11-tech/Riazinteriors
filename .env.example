# Frontend: false keeps the original Figma illustrative concepts visible.
# Change to true only when your deployed /api/projects is configured.
VITE_PROJECTS_ENABLED=false

# Formspree: create a form with verified recipient sameerriaz69@gmail.com
VITE_FORMSPREE_ENDPOINT=

# Backend: configure these on Vercel as server-only environment variables.
# Never use the VITE_ prefix for private credentials.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
